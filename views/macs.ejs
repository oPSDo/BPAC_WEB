<%- include('partials/header') %>

<main class="main-wrapper">
    <%- include('partials/kpi_cards') %>

    <h2 class="section-main-heading">CÔNG THỨC TRỘN</h2>

    <div class="table-action-bar">
        <button class="btn-add-green" onclick="openAddModal()">
            <i class="fa-solid fa-plus"></i> Thêm
        </button>
        <div class="search-input-group">
            <input type="text" placeholder="Tìm tên mác...">
            <button><i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm</button>
        </div>
    </div>

    <div class="table-responsive-box">
        <table class="custom-data-table">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tên Mác</th>
                    <th>Cốt liệu 1</th>
                    <th>Cốt liệu 2</th>
                    <th>Cốt liệu 3</th>
                    <th>Cốt liệu 4</th>
                    <th>Cốt liệu 5</th>
                    <th>Phụ gia 1</th>
                    <th>Phụ gia 2</th>
                    <th>Tên PG1</th>
                    <th>Tên PG2</th>
                    <th>Tên CL1</th>
                    <th>Tên CL2</th>
                    <th>Tên CL3</th>
                    <th>Tên CL4</th>
                    <th>Tên CL5</th>
                    <th>Độ sụt</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                <% if (macs && macs.length > 0) { %>
                    <% macs.forEach(m => { %>
                        <tr>
                            <td><%= m.stt %></td>
                            <td><strong><%= m.ten_mac %></strong></td>
                            <td><%= m.cl1 %></td>
                            <td><%= m.cl2 %></td>
                            <td><%= m.cl3 %></td>
                            <td><%= m.cl4 %></td>
                            <td><%= m.cl5 %></td>
                            <td><%= m.pg1 %></td>
                            <td><%= m.pg2 %></td>
                            <td><%= m.ten_pg1 %></td>
                            <td><%= m.ten_pg2 %></td>
                            <td><%= m.ten_cl1 %></td>
                            <td><%= m.ten_cl2 %></td>
                            <td><%= m.ten_cl3 %></td>
                            <td><%= m.ten_cl4 %></td>
                            <td><%= m.ten_cl5 %></td>
                            <td><%= m.do_sut %></td>
                            <td>
                                <button class="btn-action-edit" onclick="editMac('<%= m.id %>')"><i class="fa-solid fa-pen"></i> Sửa</button>
                                <button class="btn-action-del" onclick="deleteMac('<%= m.id %>')"><i class="fa-solid fa-trash-can"></i> Xóa</button>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="27" class="empty-state">Chưa có công thức trộn nào.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</main>

<%- include('partials/footer') %>
