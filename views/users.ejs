<%- include('partials/header') %>

<main class="main-wrapper">
    <%- include('partials/kpi_cards') %>

    <h2 class="section-main-heading">QUẢN LÝ NGƯỜI DÙNG</h2>

    <div class="table-action-bar">
        <button class="btn-add-green" onclick="openAddUserModal()">
            <i class="fa-solid fa-user-plus"></i> Thêm người dùng
        </button>
        <div class="search-input-group">
            <input type="text" id="searchInputUsers" placeholder="Tìm tên, họ tên, vai trò..." onkeyup="searchUserTable()">
            <button onclick="searchUserTable()"><i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm</button>
        </div>
    </div>

    <div class="table-responsive-box">
        <table class="custom-data-table" id="userTable">
            <thead>
                <tr>
                    <th style="width: 50px;">STT</th>
                    <th>Tên đăng nhập</th>
                    <th>Họ và tên</th>
                    <th>Vai trò</th>
                    <th>Trạm phân quyền</th>
                    <th>Điện thoại</th>
                    <th>Trạng thái</th>
                    <th style="width: 140px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
                    <% users.forEach(u => { %>
                        <tr id="row-user-<%= u.id %>">
                            <td><%= u.stt %></td>
                            <td><strong style="color: #0d47a1;"><%= u.username %></strong></td>
                            <td><%= u.fullname || '' %></td>
                            <td>
                                <% if (u.role === 'admin') { %>
                                    <span style="background: #e0f2fe; color: #0369a1; padding: 3px 8px; border-radius: 4px; font-weight: 600; font-size: 12px;">Quản trị viên</span>
                                <% } else if (u.role === 'operator') { %>
                                    <span style="background: #dcfce7; color: #15803d; padding: 3px 8px; border-radius: 4px; font-weight: 600; font-size: 12px;">Vận hành trạm</span>
                                <% } else { %>
                                    <span style="background: #f1f5f9; color: #475569; padding: 3px 8px; border-radius: 4px; font-weight: 600; font-size: 12px;">Giám sát</span>
                                <% } %>
                            </td>
                            <td><%= u.tram || 'Tất cả các trạm' %></td>
                            <td><%= u.phone || '' %></td>
                            <td>
                                <% if (u.active == 1 || u.active === undefined) { %>
                                    <span style="color: #16a34a; font-weight: 600;"><i class="fa-solid fa-circle-check"></i> Hoạt động</span>
                                <% } else { %>
                                    <span style="color: #dc2626; font-weight: 600;"><i class="fa-solid fa-circle-xmark"></i> Bị khóa</span>
                                <% } %>
                            </td>
                            <td>
                                <button class="btn-action-edit" onclick="editUser('<%= u.id %>')"><i class="fa-solid fa-pen"></i> Sửa</button>
                                <% if (u.username !== 'admin') { %>
                                    <button class="btn-action-del" onclick="deleteUser('<%= u.id %>')"><i class="fa-solid fa-trash-can"></i> Xóa</button>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="empty-state">Chưa có người dùng nào.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- MODAL THÊM / SỬA NGƯỜI DÙNG -->
    <div id="userModal" class="modal-overlay">
        <div class="modal-box" style="max-width: 540px;">
            <div class="modal-header">
                <h3 id="modalUserTitle">Thêm Người Dùng Mới</h3>
                <button type="button" class="modal-close-btn" onclick="closeUserModal()">&minus;</button>
            </div>
            <form id="userForm" onsubmit="saveUserForm(event)">
                <input type="hidden" id="userId" name="id" value="">

                <div class="form-control-item">
                    <label for="username">*Tên đăng nhập (Username):</label>
                    <input type="text" id="username" name="username" placeholder="VD: kythuat_enq, operator01" required>
                </div>

                <div class="form-control-item">
                    <label for="password">Mật khẩu:</label>
                    <input type="password" id="password" name="password" placeholder="Nhập mật khẩu (để trống nếu không đổi)">
                </div>

                <div class="form-control-item">
                    <label for="fullname">*Họ và tên:</label>
                    <input type="text" id="fullname" name="fullname" placeholder="Họ và tên nhân viên / kỹ sư" required>
                </div>

                <div class="form-control-item">
                    <label for="role">Vai trò phân quyền:</label>
                    <select id="role" name="role" style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 4px;">
                        <option value="admin">Quản trị viên (Toàn quyền)</option>
                        <option value="operator" selected>Kỹ sư vận hành (Xem & Cập nhật trạm)</option>
                        <option value="viewer">Giám sát / Khách hàng (Chỉ xem)</option>
                    </select>
                </div>

                <div class="form-control-item">
                    <label for="tram">Trạm được phân quyền:</label>
                    <select id="tram" name="tram" style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 4px;">
                        <option value="Tất cả các trạm" selected>Tất cả các trạm</option>
                        <option value="Trạm Trộn Asphalt ENQ 01">Trạm Trộn Asphalt ENQ 01</option>
                        <option value="Trạm Trộn Asphalt ENQ 02">Trạm Trộn Asphalt ENQ 02</option>
                    </select>
                </div>

                <div class="form-control-item">
                    <label for="phone">Số điện thoại liên hệ:</label>
                    <input type="text" id="phone" name="phone" placeholder="VD: 0913383246">
                </div>

                <div class="form-control-item">
                    <label for="email">Địa chỉ Email:</label>
                    <input type="email" id="email" name="email" placeholder="VD: operator@enq.com.vn">
                </div>

                <div class="form-control-item">
                    <label for="active">Trạng thái tài khoản:</label>
                    <select id="active" name="active" style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 4px;">
                        <option value="1" selected>Hoạt động bình thường</option>
                        <option value="0">Khóa tài khoản</option>
                    </select>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-modal-cancel" onclick="closeUserModal()">Đóng</button>
                    <button type="submit" class="btn-modal-save"><i class="fa-solid fa-floppy-disk"></i> Lưu người dùng</button>
                </div>
            </form>
        </div>
    </div>
</main>

<script>
    const usersData = <%- JSON.stringify(users || []) %>;

    function openAddUserModal() {
        document.getElementById('modalUserTitle').textContent = 'Thêm Người Dùng Mới';
        document.getElementById('userForm').reset();
        document.getElementById('userId').value = '';
        document.getElementById('username').removeAttribute('readonly');
        document.getElementById('userModal').classList.add('show');
    }

    function closeUserModal() {
        document.getElementById('userModal').classList.remove('show');
    }

    window.addEventListener('click', function(e) {
        const modal = document.getElementById('userModal');
        if (e.target === modal) {
            closeUserModal();
        }
    });

    function editUser(id) {
        const found = usersData.find(u => String(u.id) === String(id));
        if (!found) {
            alert('Không tìm thấy người dùng!');
            return;
        }

        document.getElementById('modalUserTitle').textContent = 'Sửa Người Dùng: ' + found.username;
        document.getElementById('userId').value = found.id || '';
        document.getElementById('username').value = found.username || '';
        document.getElementById('password').value = '';
        document.getElementById('fullname').value = found.fullname || '';
        document.getElementById('role').value = found.role || 'operator';
        document.getElementById('tram').value = found.tram || 'Tất cả các trạm';
        document.getElementById('phone').value = found.phone || '';
        document.getElementById('email').value = found.email || '';
        document.getElementById('active').value = found.active !== undefined ? found.active : 1;

        document.getElementById('userModal').classList.add('show');
    }

    function saveUserForm(e) {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        fetch('/users/save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(async res => {
            const data = await res.json().catch(() => null);
            if (!res.ok) {
                throw new Error((data && data.message) ? data.message : ('Lỗi HTTP ' + res.status));
            }
            return data;
        })
        .then(data => {
            if (data && data.success) {
                alert(payload.id ? 'Cập nhật người dùng thành công!' : 'Thêm mới người dùng thành công!');
                closeUserModal();
                location.reload();
            } else {
                alert('Lỗi: ' + (data && data.message ? data.message : 'Không thể lưu'));
            }
        })
        .catch(err => {
            console.error(err);
            alert('Lỗi lưu người dùng: ' + err.message);
        });
    }

    function deleteUser(id) {
        if (!confirm('Bạn có chắc chắn muốn xóa người dùng này không?')) {
            return;
        }

        fetch('/users/delete/' + encodeURIComponent(id), {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            }
        })
        .then(async res => {
            const data = await res.json().catch(() => null);
            if (!res.ok) {
                throw new Error((data && data.message) ? data.message : ('Lỗi HTTP ' + res.status));
            }
            return data;
        })
        .then(data => {
            if (data && data.success) {
                alert('Đã xóa người dùng thành công!');
                location.reload();
            } else {
                alert('Lỗi: ' + (data && data.message ? data.message : 'Không thể xóa'));
            }
        })
        .catch(err => {
            console.error(err);
            alert('Lỗi gửi yêu cầu xóa: ' + err.message);
        });
    }

    function searchUserTable() {
        const val = document.getElementById('searchInputUsers').value.toLowerCase().trim();
        const rows = document.querySelectorAll('#userTable tbody tr');
        rows.forEach(r => {
            if (r.querySelector('.empty-state')) return;
            const text = r.innerText.toLowerCase();
            r.style.display = text.includes(val) ? '' : 'none';
        });
    }
</script>

<%- include('partials/footer') %>
