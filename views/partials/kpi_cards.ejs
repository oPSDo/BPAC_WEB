<div class="kpi-header-wrapper">
    <div class="station-selector-row">
        <select class="station-select">
            <option selected>Trạm Trộn Asphalt ENQ 01</option>
            <option>Trạm Trộn Asphalt ENQ 02</option>
        </select>
    </div>

    <div class="kpi-six-cards">
        <div class="kpi-mini-card">
            <div class="kpi-title">Tích lũy năm</div>
            <div class="kpi-body">
                <div class="kpi-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.nam_m3 : '0,0' %> m³</div>
                <div class="kpi-sub-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.nam_kg : '0' %> Kg</div>
            </div>
        </div>

        <div class="kpi-mini-card">
            <div class="kpi-title">Tích lũy tháng</div>
            <div class="kpi-body">
                <div class="kpi-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.thang_m3 : '0,0' %> m³</div>
                <div class="kpi-sub-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.thang_kg : '0' %> Kg</div>
            </div>
        </div>

        <div class="kpi-mini-card">
            <div class="kpi-title">Tích lũy ngày</div>
            <div class="kpi-body">
                <div class="kpi-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.ngay_m3 : '0,0' %> m³</div>
                <div class="kpi-sub-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.ngay_kg : '0' %> Kg</div>
            </div>
        </div>

        <div class="kpi-mini-card">
            <div class="kpi-title">Tổng cốt liệu</div>
            <div class="kpi-body kpi-body-bottom">
                <div class="kpi-sub-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.tong_vat_lieu : '0' %> Kg</div>
            </div>
        </div>

        <div class="kpi-mini-card">
            <div class="kpi-title">Tổng nhựa đường</div>
            <div class="kpi-body kpi-body-bottom">
                <div class="kpi-sub-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.tong_nhua : '0' %> Kg</div>
            </div>
        </div>

        <div class="kpi-mini-card">
            <div class="kpi-title">Tổng phụ gia & bột đá</div>
            <div class="kpi-body kpi-body-bottom">
                <div class="kpi-sub-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.tong_phu_gia : '0' %> Kg</div>
            </div>
        </div>
    </div>
</div>
