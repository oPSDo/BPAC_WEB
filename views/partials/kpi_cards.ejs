<div class="kpi-header-wrapper">
    <div class="station-selector-row">
        <select class="station-select">
            <option selected>Trạm Trộn Asphalt ENQ 01</option>
            <option>Trạm Trộn Asphalt ENQ 02</option>
        </select>
    </div>

    <div class="kpi-six-cards">
        <div class="kpi-mini-card">
            <div class="kpi-title">Tích lũy năm</div>
            <div class="kpi-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.nam_m3 : '10.487,8' %> m³</div>
            <div class="kpi-sub-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.nam_kg : '11.531.643,4' %> Kg</div>
        </div>

        <div class="kpi-mini-card">
            <div class="kpi-title">Tích lũy tháng</div>
            <div class="kpi-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.thang_m3 : '0' %> m³</div>
            <div class="kpi-sub-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.thang_kg : '0' %> Kg</div>
        </div>

        <div class="kpi-mini-card">
            <div class="kpi-title">Tích lũy ngày</div>
            <div class="kpi-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.ngay_m3 : '0' %> m³</div>
            <div class="kpi-sub-val blue-text"><%= typeof kpi !== 'undefined' ? kpi.ngay_kg : '0' %> Kg</div>
        </div>

        <div class="kpi-mini-card">
            <div class="kpi-title">Tổng vật liệu</div>
            <div class="kpi-val blue-text kpi-single"><%= typeof kpi !== 'undefined' ? kpi.tong_vat_lieu : '8.451.495,0' %> Kg</div>
        </div>

        <div class="kpi-mini-card">
            <div class="kpi-title">Tổng xi măng</div>
            <div class="kpi-val blue-text kpi-single"><%= typeof kpi !== 'undefined' ? kpi.tong_xi_mang : '2.162.653,0' %> Kg</div>
        </div>

        <div class="kpi-mini-card">
            <div class="kpi-title">Tổng phụ gia</div>
            <div class="kpi-val blue-text kpi-single"><%= typeof kpi !== 'undefined' ? kpi.tong_phu_gia : '68.887,4' %> Kg</div>
        </div>
    </div>
</div>
